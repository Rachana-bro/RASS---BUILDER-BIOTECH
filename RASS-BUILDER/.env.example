# ==============================================================================
# RASS-BUILDER: Production Environment Configuration Template
# Copy this file to .env and adjust values for your deployment environment.
# ==============================================================================

# Application Environment Mode (production | development | testing)
RASS_ENV=production

# Logging Verbosity Level (INFO | WARNING | ERROR | DEBUG)
# Production recommendation: INFO or WARNING (never DEBUG in production)
RASS_LOG_LEVEL=INFO

# Persistent Relational Database Location (SQLite WAL engine)
# Defaults to backend/data/rass_builder.db if left unset
RASS_DB_PATH=backend/data/rass_builder.db

# Explicit CORS Whitelist (comma-separated origins)
# Production recommendation: Set to your exact frontend domain(s)
RASS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Maximum File Upload & Request Payload Limit (in Megabytes)
# Default: 25 MB
RASS_MAX_UPLOAD_SIZE_MB=25

# Rate Limiting & Abuse Prevention (1 = enabled, 0 = disabled)
# Protects authentication, file upload, job creation, and analysis endpoints
RASS_RATE_LIMIT_ENABLED=1

# Global Authentication Enforcement (1 = strict mandatory auth, 0 = open with role access control)
# Default: 0 (preserves backward-compatible exploratory API access)
RASS_REQUIRE_AUTH=0

# Optional: Path to custom PyTorch DNA Transformer weights checkpoint (.pt / .pth)
# If left blank, the architecture operates with certified unvalidated-model safeguards
RASS_MODEL_PATH=

# Server Host & Port
HOST=0.0.0.0
PORT=8000
